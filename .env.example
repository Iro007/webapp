# Base URL of the backend API (used by src/core/http)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Jev provider: mock (no key, default) | typesafe (real Jev) | openrouter (LLM emulation)
JEV_PROVIDER=mock
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-router

# Luma webhook signing secret (whsec_...). Without it the simulator uses a public demo secret.
LUMA_WEBHOOK_SECRET=
